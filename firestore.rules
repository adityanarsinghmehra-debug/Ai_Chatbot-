rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-.:]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isValidSharedMemory(mem) {
      return mem is map
        && mem.keys().hasAll(['userName', 'facts'])
        && mem.keys().hasOnly(['userName', 'facts'])
        && mem.userName is string
        && mem.userName.size() <= 80
        && mem.facts is list
        && mem.facts.size() <= 25
        && (mem.facts.size() == 0 || (mem.facts[0] is string && mem.facts[0].size() <= 240));
    }

    function isValidSettings(settings) {
      return settings is map
        && settings.keys().hasAll(['systemInstruction', 'temperature', 'model', 'theme'])
        && settings.keys().hasOnly(['systemInstruction', 'temperature', 'model', 'theme'])
        && settings.systemInstruction is string
        && settings.systemInstruction.size() <= 2000
        && (settings.temperature is float || settings.temperature is int)
        && settings.temperature >= 0
        && settings.temperature <= 2
        && settings.model is string
        && settings.model.size() >= 1
        && settings.model.size() <= 60
        && settings.theme in ['light', 'dark'];
    }

    function isValidUserProfile(data, uid) {
      return data.keys().hasAll([
          'uid',
          'displayName',
          'email',
          'photoURL',
          'shareMemoryEnabled',
          'sharedMemory',
          'settings',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'uid',
          'displayName',
          'email',
          'photoURL',
          'shareMemoryEnabled',
          'sharedMemory',
          'settings',
          'createdAt',
          'updatedAt'
        ])
        && data.uid == uid
        && data.uid == request.auth.uid
        && data.displayName is string
        && data.displayName.size() <= 80
        && data.email is string
        && data.email.size() <= 160
        && data.photoURL is string
        && data.photoURL.size() <= 500
        && data.shareMemoryEnabled is bool
        && isValidSharedMemory(data.sharedMemory)
        && isValidSettings(data.settings)
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidChatThread(data, uid, chatId) {
      return data.keys().hasAll([
          'id',
          'ownerId',
          'title',
          'messageCount',
          'lastMessagePreview',
          'createdAt',
          'updatedAt'
        ])
        && data.keys().hasOnly([
          'id',
          'ownerId',
          'title',
          'messageCount',
          'lastMessagePreview',
          'createdAt',
          'updatedAt'
        ])
        && data.id == chatId
        && data.ownerId == uid
        && data.ownerId == request.auth.uid
        && data.title is string
        && data.title.size() >= 1
        && data.title.size() <= 120
        && data.messageCount is int
        && data.messageCount >= 0
        && data.messageCount <= 500
        && data.lastMessagePreview is string
        && data.lastMessagePreview.size() <= 200
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidChatMessage(data, uid, chatId, messageId) {
      return data.keys().hasAll([
          'id',
          'chatId',
          'ownerId',
          'role',
          'content',
          'modelUsed',
          'createdAt'
        ])
        && data.keys().hasOnly([
          'id',
          'chatId',
          'ownerId',
          'role',
          'content',
          'modelUsed',
          'createdAt'
        ])
        && data.id == messageId
        && data.chatId == chatId
        && data.ownerId == uid
        && data.ownerId == request.auth.uid
        && data.role in ['user', 'assistant']
        && data.content is string
        && data.content.size() >= 1
        && data.content.size() <= 16000
        && data.modelUsed is string
        && data.modelUsed.size() <= 80
        && data.createdAt is timestamp;
    }

    match /users/{uid} {
      allow get: if isValidId(uid) && isOwner(uid);
      allow list: if false;
      allow create: if isValidId(uid)
        && isOwner(uid)
        && isValidUserProfile(incoming(), uid)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(uid)
        && isOwner(uid)
        && isValidUserProfile(incoming(), uid)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          incoming().diff(existing()).affectedKeys().hasOnly(['sharedMemory', 'shareMemoryEnabled', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['settings', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'photoURL', 'updatedAt'])
          || incoming().diff(existing()).affectedKeys().hasOnly([
            'sharedMemory',
            'shareMemoryEnabled',
            'settings',
            'displayName',
            'email',
            'photoURL',
            'updatedAt'
          ])
        );
      allow delete: if isValidId(uid) && isOwner(uid);

      match /chats/{chatId} {
        allow get: if isValidId(uid) && isValidId(chatId) && isOwner(uid);
        allow list: if isOwner(uid) && resource.data.ownerId == request.auth.uid;
        allow create: if isValidId(uid)
          && isValidId(chatId)
          && isOwner(uid)
          && isValidChatThread(incoming(), uid, chatId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && exists(/databases/$(database)/documents/users/$(uid));
        allow update: if isValidId(uid)
          && isValidId(chatId)
          && isOwner(uid)
          && isValidChatThread(incoming(), uid, chatId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && (
            incoming().diff(existing()).affectedKeys().hasOnly(['title', 'updatedAt'])
            || incoming().diff(existing()).affectedKeys().hasOnly(['messageCount', 'lastMessagePreview', 'title', 'updatedAt'])
          );
        allow delete: if isValidId(uid) && isValidId(chatId) && isOwner(uid);

        match /messages/{messageId} {
          allow get: if isValidId(uid) && isValidId(chatId) && isValidId(messageId) && isOwner(uid);
          allow list: if isOwner(uid) && resource.data.ownerId == request.auth.uid;
          allow create: if isValidId(uid)
            && isValidId(chatId)
            && isValidId(messageId)
            && isOwner(uid)
            && isValidChatMessage(incoming(), uid, chatId, messageId)
            && incoming().createdAt == request.time
            && exists(/databases/$(database)/documents/users/$(uid)/chats/$(chatId));
          allow update: if false;
          allow delete: if isValidId(uid) && isValidId(chatId) && isValidId(messageId) && isOwner(uid);
        }
      }
    }
  }
}
